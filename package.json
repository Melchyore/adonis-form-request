{
  "name": "@melchyore/adonis-form-request",
  "description": "Use dedicated classes to authorize and validate requests",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.16.0"
  },
  "type": "module",
  "keywords": [
    "typescript",
    "adonisjs",
    "package",
    "template",
    "adonis",
    "form",
    "request",
    "http",
    "response",
    "context",
    "validator",
    "validation",
    "validate",
    "authorize",
    "authorization",
    "right",
    "bouncer",
    "framework",
    "authenticated",
    "rules",
    "controller",
    "error",
    "schema",
    "schema-validation",
    "indicative",
    "node",
    "nodejs",
    "sanitize",
    "sanitization",
    "xss",
    "permission",
    "route",
    "routing"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write .",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "build": "tsc",
    "postbuild": "npm run copy:templates",
    "index:commands": "adonis-kit index build/commands",
    "release": "np",
    "version": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.1.0",
    "@adonisjs/bodyparser": "^10.0.1",
    "@adonisjs/core": "^6.2.0",
    "@adonisjs/eslint-config": "^1.2.1",
    "@adonisjs/http-server": "^7.0.2",
    "@adonisjs/lucid": "^20.0.0",
    "@adonisjs/prettier-config": "^1.2.1",
    "@adonisjs/sink": "^5.4.3",
    "@adonisjs/tsconfig": "^1.2.1",
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@japa/api-client": "^2.0.2",
    "@japa/assert": "^2.1.0",
    "@japa/expect": "^3.0.1",
    "@japa/run-failed-tests": "^1.1.1",
    "@japa/runner": "^3.1.1",
    "@japa/spec-reporter": "^1.3.3",
    "@poppinss/dev-utils": "^2.0.3",
    "@poppinss/utils": "^6.7.1",
    "@swc/core": "^1.3.106",
    "@types/node": "^20.11.9",
    "@types/supertest": "^6.0.2",
    "@vinejs/vine": "^1.7.0",
    "adonis-preset-ts": "^2.1.0",
    "c8": "^9.1.0",
    "commitizen": "^4.3.0",
    "copyfiles": "^2.4.1",
    "cz-conventional-changelog": "^3.3.0",
    "del-cli": "^5.1.0",
    "eslint": "^8.56.0",
    "execa": "^8.0.1",
    "github-label-sync": "^2.3.1",
    "husky": "^9.0.6",
    "lint-staged": "^15.2.0",
    "np": "^9.2.0",
    "prettier": "^3.2.4",
    "reflect-metadata": "^0.2.1",
    "source-map-support": "^0.5.21",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@adonisjs/application": "^5.0.0",
    "@adonisjs/core": "^6.2.0",
    "@adonisjs/lucid": "^20.0.0",
    "@vinejs/vine": "^1.7.0"
  },
  "main": "./build/index.js",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/package"
  },
  "prettier": "@adonisjs/prettier-config",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "np": {
    "contents": ".",
    "anyBranch": false
  },
  "author": {
    "name": "Oussama Benhamed",
    "email": "b.oussama@corposmart.dz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melchyore/adonis-form-request.git"
  },
  "bugs": {
    "url": "https://github.com/Melchyore/adonis-form-request/issues"
  },
  "homepage": "https://github.com/Melchyore/adonis-form-request#readme",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@adonisjs/route-model-binding": "^1.0.1",
    "@poppinss/hooks": "^7.2.2"
  }
}
